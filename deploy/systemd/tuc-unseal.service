[Unit]
Description=Deliver the TUC secret
After=tuc.service
PartOf=tuc.service

[Service]
Type=oneshot
User=tuc
Group=tuc
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/local/libexec/tuc-deliver
TimeoutStartSec=30
Restart=on-failure
RestartSec=5
RemainAfterExit=yes

[Install]
WantedBy=tuc.service
