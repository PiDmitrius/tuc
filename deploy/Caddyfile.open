{
 admin off
 auto_https off
}
https://{$TUC_HOST} {
 tls /tls/fullchain.pem /tls/key.pem
 reverse_proxy {$TUC_UPSTREAM}
}
http://{$TUC_HOST} {
 @publication {
  method GET HEAD
  path_regexp http_publication ^/[0-9A-Fa-f]{40}(\.(crt|crl)|/(ca\.crt|crl|ocsp/.+))$
 }
 @service {
  method POST
  path_regexp http_service ^/[0-9A-Fa-f]{40}/(ocsp|tsp)$
 }
 route {
  handle @publication {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle @service {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle {
   redir https://{$TUC_HOST}{uri} 308
  }
 }
}
