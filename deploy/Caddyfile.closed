{
 admin off
 auto_https off
}
https://{$TUC_HOST} {
 tls /tls/fullchain.pem /tls/key.pem
 @trusted remote_ip {$TUC_TRUSTED_CIDRS}
 @publication {
  method GET HEAD
  path_regexp publication ^/[0-9A-Fa-f]{40}(\.(crt|crl)|/ocsp/.+)$
 }
 @ocsp {
  method POST
  path_regexp ocsp ^/[0-9A-Fa-f]{40}/ocsp$
 }
 route {
  handle @trusted {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle @publication {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle @ocsp {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle {
   respond "trusted network required" 403
  }
 }
}
http://{$TUC_HOST} {
 @publication {
  method GET HEAD
  path_regexp http_publication ^/[0-9A-Fa-f]{40}(\.(crt|crl)|/ocsp/.+)$
 }
 @service {
  method POST
  path_regexp http_service ^/[0-9A-Fa-f]{40}/(ocsp|tsp)$
 }
 route {
  handle @publication {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle @service {
   reverse_proxy {$TUC_UPSTREAM}
  }
  handle {
   redir https://{$TUC_HOST}{uri} 308
  }
 }
}
